---
interface Props {
  title: string;
  description?: string;
  compact?: boolean;
}

const { title, description = 'Visual learning platform for BTech CSE students', compact = false } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title} | OpenCS</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet" />

    {/* Theme initialization — runs before paint to prevent flash */}
    <script is:inline>
      (function() {
        try {
          var stored = localStorage.getItem('theme');
          var theme = stored === 'dark' ? 'dark' : 'light';
          document.documentElement.setAttribute('data-theme', theme);
        } catch (e) {}
      })();
    </script>
  </head>
  <body class={compact ? 'compact' : ''}>
    <slot />
  </body>
</html>

<style is:global>
  @import '../styles/global.css';

  /* Dot grid background for topic pages */
  body:not(.compact) {
    position: relative;
  }

  body:not(.compact)::before {
    content: '';
    position: fixed;
    inset: 0;
    background-image: radial-gradient(circle, var(--color-border) 1px, transparent 1px);
    background-size: 24px 24px;
    opacity: 0.08;
    z-index: -1;
    pointer-events: none;
  }

  .container {
    max-width: var(--max-content);
    margin: 0 auto;
    padding: 0 var(--space-lg);
  }

  @media (max-width: 768px) {
    .container {
      padding: 0 var(--space-md);
    }
  }
</style>
