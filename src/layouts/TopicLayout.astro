---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';

interface Props {
  title: string;
  description?: string;
  difficulty?: string;
  estimatedTime?: string;
  category?: string;
  engine?: string;
  status?: string;
  prerequisites?: string[];
  learningObjectives?: string[];
}

const { title, description, difficulty, estimatedTime, category, engine, status, prerequisites = [], learningObjectives = [] } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <Header />
  <main class="topic-main">
    <article class="topic-article container">
      <!-- Breadcrumb could be added here -->

      <header class="topic-header">
        <h1>{title}</h1>
        {description && <p class="topic-description">{description}</p>}

        <div class="topic-meta">
          {category && <span class="meta-pill category">{category}</span>}
          {difficulty && <span class="meta-pill difficulty">{difficulty}</span>}
          {estimatedTime && <span class="meta-pill time">{estimatedTime}</span>}
          {engine && <span class="meta-pill engine">{engine}</span>}
        </div>

        {learningObjectives.length > 0 && (
          <div class="topic-objectives">
            <h4>Learning Objectives</h4>
            <ul>
              {learningObjectives.map(obj => <li>{obj}</li>)}
            </ul>
          </div>
        )}
      </header>

      <div class="topic-content">
        <slot />
      </div>
    </article>
  </main>
  <Footer />
</BaseLayout>

<style>
  .topic-main {
    padding: var(--space-2xl) 0;
    padding-top: calc(var(--header-height) + var(--space-xl));
  }

  .topic-article {
    max-width: var(--max-content);
  }

  .topic-header {
    margin-bottom: var(--space-2xl);
    padding-bottom: var(--space-lg);
    border-bottom: 1px solid var(--color-border);
  }

  .topic-header h1 {
    margin-bottom: var(--space-sm);
  }

  .topic-description {
    font-size: 1.125rem;
    color: var(--color-text-muted);
    line-height: 1.7;
    margin-bottom: var(--space-lg);
    max-width: 640px;
  }

  .topic-meta {
    display: flex;
    gap: var(--space-sm);
    flex-wrap: wrap;
    margin-bottom: var(--space-lg);
  }

  .meta-pill {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: var(--space-xs) var(--space-sm);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    color: var(--color-text-muted);
  }

  .meta-pill.category {
    color: var(--color-primary);
    border-color: var(--color-primary);
    background: var(--color-primary-light);
  }

  .meta-pill.engine {
    color: var(--color-text-muted);
    border-color: var(--color-border);
  }

  .meta-pill.difficulty {
    color: var(--color-text-muted);
  }

  .meta-pill.time {
    color: var(--color-text-muted);
  }

  .topic-objectives {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: var(--space-md) var(--space-lg);
  }

  .topic-objectives h4 {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
    margin-bottom: var(--space-sm);
    font-weight: 500;
  }

  .topic-objectives ul {
    margin: 0;
    padding-left: var(--space-lg);
    list-style: decimal;
  }

  .topic-objectives li {
    font-size: 0.875rem;
    line-height: 1.6;
    margin-bottom: var(--space-xs);
    color: var(--color-text-body);
  }

  .topic-content {
    line-height: 1.8;
  }

  .topic-content :global(h2) {
    margin-top: var(--space-2xl);
    margin-bottom: var(--space-md);
    padding-top: var(--space-lg);
    border-top: 1px solid var(--color-border);
  }

  .topic-content :global(h3) {
    margin-top: var(--space-xl);
    margin-bottom: var(--space-md);
  }

  .topic-content :global(p) {
    margin-bottom: var(--space-md);
  }

  .topic-content :global(ul),
  .topic-content :global(ol) {
    margin-bottom: var(--space-md);
    padding-left: var(--space-xl);
  }

  .topic-content :global(li) {
    margin-bottom: var(--space-sm);
  }

  .topic-content :global(pre) {
    margin-bottom: var(--space-lg);
  }

  .topic-content :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: var(--space-lg);
    font-size: 0.875rem;
  }

  .topic-content :global(th),
  .topic-content :global(td) {
    padding: var(--space-sm) var(--space-md);
    border: 1px solid var(--color-border);
    text-align: left;
  }

  .topic-content :global(th) {
    background: var(--color-surface-alt);
    font-weight: 600;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .topic-content :global(.visualizer) {
    margin: var(--space-xl) 0;
  }

  :global(.topic-nav) {
    margin-top: var(--space-2xl);
    padding-top: var(--space-lg);
    border-top: 1px solid var(--color-border);
  }

  :global(.topic-nav-inner) {
    display: flex;
    justify-content: space-between;
    gap: var(--space-md);
  }

  :global(.topic-nav-link) {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: var(--space-md);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    text-decoration: none;
    transition: border-color var(--transition);
    max-width: 280px;
    flex: 1;
  }

  :global(.topic-nav-link:hover) {
    border-color: var(--color-primary);
    text-decoration: none;
  }

  :global(.topic-nav-next) {
    text-align: right;
    margin-left: auto;
    align-items: flex-end;
  }

  :global(.topic-nav-direction) {
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
  }

  :global(.topic-nav-title) {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-text);
  }

  @media (max-width: 640px) {
    .topic-meta {
      flex-wrap: wrap;
    }

    :global(.topic-nav-inner) {
      flex-direction: column;
    }

    :global(.topic-nav-link) {
      max-width: 100%;
    }

    :global(.topic-nav-next) {
      align-items: flex-start;
    }
  }
</style>
