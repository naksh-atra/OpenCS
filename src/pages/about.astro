---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
---

<BaseLayout title="About" description="About the OpenCS project">
  <Header />
  <main>
    <section class="page-header">
      <div class="container">
        <h1>About OpenCS</h1>
        <p class="page-intro">
          OpenCS is an open-source visual learning platform designed specifically for BTech CSE students in India.
          Our mission is to make computer science fundamentals accessible, intuitive, and free.
        </p>
      </div>
    </section>

    <section class="stats-section">
      <div class="container">
        <div class="stats-grid">
          <div class="stat-card">
            <span class="stat-number">20</span>
            <span class="stat-label">Interactive Topics</span>
          </div>
          <div class="stat-card">
            <span class="stat-number">4</span>
            <span class="stat-label">Reusable Engines</span>
          </div>
          <div class="stat-card">
            <span class="stat-number">58</span>
            <span class="stat-label">E2E Tests</span>
          </div>
          <div class="stat-card">
            <span class="stat-number">6</span>
            <span class="stat-label">Content Sections</span>
            <span class="stat-label-small">per topic</span>
          </div>
        </div>
      </div>
    </section>

    <section class="content-section">
      <div class="container narrow">
        <h2>Our Mission</h2>
        <p>
          Every BTech CSE student in India deserves access to high-quality, visual learning resources.
          OpenCS bridges the gap between theoretical concepts and intuitive understanding through
          interactive visualizations powered by reusable engines.
        </p>

        <h2>Design Philosophy</h2>
        <p>
          We believe in <strong>textbook-modern</strong> design — clean, academic, and focused on clarity.
          No flashy animations or startup SaaS aesthetics. Just clear explanations, interactive widgets,
          and step-by-step examples that work.
        </p>

        <h2>Architecture</h2>
        <p>
          OpenCS is built on four reusable engines that power all visualizations:
        </p>
        <ul>
          <li><strong>Sequence Engine</strong> — Linear operations: sorting, recursion, time complexity</li>
          <li><strong>TreeGraph Engine</strong> — Hierarchical structures: trees, BSTs, graphs</li>
          <li><strong>Theory Engine</strong> — Formal systems: DFA/NFA, automata</li>
          <li><strong>SystemProcess Engine</strong> — OS simulations: CPU scheduling</li>
        </ul>

        <h2>Open Source</h2>
        <p>
          Licensed under MIT, OpenCS welcomes contributions from educators, developers, and students.
          Every contribution follows our pedagogy standards to ensure consistent educational quality.
        </p>

        <h2>Technology</h2>
        <p>
          Built with Astro for static generation, React for interactive components, and MDX for content.
          Deployed to GitHub Pages for fast, free access to anyone.
        </p>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  .page-header {
    padding: calc(var(--header-height) + var(--space-xl)) 0 var(--space-xl);
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
  }

  .page-header h1 {
    margin-bottom: var(--space-md);
  }

  .page-intro {
    font-size: 1.125rem;
    color: var(--color-text-muted);
    max-width: 36rem;
    line-height: 1.7;
  }

  .stats-section {
    padding: var(--space-xl) 0;
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-md);
  }

  .stat-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    padding: var(--space-md) var(--space-sm);
    text-align: center;
  }

  .stat-number {
    font-family: var(--font-mono);
    font-size: 2rem;
    font-weight: 700;
    color: var(--color-primary);
    line-height: 1;
  }

  .stat-label {
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }

  .stat-label-small {
    font-size: 0.625rem;
    color: var(--color-text-muted);
    opacity: 0.7;
  }

  @media (max-width: 640px) {
    .stats-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .content-section {
    padding: var(--space-xl) 0;
  }

  .container.narrow {
    max-width: 48rem;
  }

  .content-section h2 {
    margin-top: var(--space-xl);
    margin-bottom: var(--space-md);
  }

  .content-section h2:first-child {
    margin-top: 0;
  }

  .content-section p {
    margin-bottom: var(--space-md);
    line-height: 1.7;
  }

  .content-section ul {
    margin-bottom: var(--space-md);
    padding-left: var(--space-lg);
  }

  .content-section li {
    margin-bottom: var(--space-xs);
  }

  .content-section strong {
    font-weight: 600;
  }
</style>