---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';

const allTopics = await getCollection('topics');
const published = allTopics.filter(t => t.data.status === 'published').length;
const total = allTopics.length;

const recentPublished = allTopics
  .filter(t => t.data.status === 'published')
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 6);
---

<BaseLayout title="Home" description="Visual learning platform for BTech CSE students in India">
  <Header />
  <main>
    <!-- Hero -->
    <section class="hero">
      <div class="hero-inner container">
        <div class="hero-text">
          <h1>Computer Science,<br/>Visualized</h1>
          <p class="hero-sub">Interactive visualizations of core BTech CSE topics — algorithms, data structures, theory of computation, and systems. Built for students in India.</p>
          <div class="hero-actions">
            <a href="/OpenCS/topics" class="btn-primary">Explore Topics</a>
            <a href="/OpenCS/contribute" class="btn-secondary">Contribute</a>
          </div>
        </div>
        <div class="hero-visual">
          <div class="visual-card graphite-border">
            <div class="visual-label">Time Complexity</div>
            <div class="visual-bars">
              <div class="bar" style="height:20%"></div>
              <div class="bar" style="height:35%"></div>
              <div class="bar" style="height:55%"></div>
              <div class="bar" style="height:100%"></div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Topics -->
    <section class="topics-section">
      <div class="container">
        <div class="section-head">
          <h2>Available Topics</h2>
          <a href="/OpenCS/topics" class="view-all">View all {total} topics →</a>
        </div>
        <div class="topics-grid">
          {recentPublished.map(topic => (
            <a href={`/OpenCS/topics/${topic.id.replace(/\.mdx?$/, '')}`} class="topic-card">
              <div class="topic-card-meta">
                <span class="pill category">{topic.data.category}</span>
                <span class="pill">{topic.data.engine}</span>
              </div>
              <h3>{topic.data.title}</h3>
              <p>{topic.data.description}</p>
              <div class="topic-card-foot">
                <span class="pill difficulty">{topic.data.difficulty}</span>
                <span class="pill time">{topic.data.estimatedTime}</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Features -->
    <section class="features-section">
      <div class="container">
        <h2>Built for Learning</h2>
        <div class="features-grid">
          <div class="feature-card graphite-border">
            <span class="f-icon">◇</span>
            <h3>Interactive Visualizers</h3>
            <p>Every topic includes a hands-on visualization. Don't just read about algorithms — watch them run.</p>
          </div>
          <div class="feature-card graphite-border">
            <span class="f-icon">▣</span>
            <h3>Reusable Engines</h3>
            <p>Four modular engines — Sequence, TreeGraph, Theory, SystemProcess — power all 20+ topics consistently.</p>
          </div>
          <div class="feature-card graphite-border">
            <span class="f-icon">○</span>
            <h3>Open Source</h3>
            <p>MIT licensed. Contribute topics, visualizers, or documentation. Built by students, for students.</p>
          </div>
          <div class="feature-card graphite-border">
            <span class="f-icon">□</span>
            <h3>GATE Focused</h3>
            <p>Content aligned with Indian university CSE curricula and GATE exam patterns. Practice prompts included.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="cta-section">
      <div class="container">
        <h2>Ready to start learning?</h2>
        <a href="/OpenCS/topics" class="btn-primary">Browse All Topics</a>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  /* Hero */
  .hero {
    padding: var(--space-xl) 0;
  }

  .hero-inner {
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: var(--space-2xl);
    align-items: center;
  }

  .hero-text h1 {
    font-size: 3rem;
    line-height: 1.1;
    margin-bottom: var(--space-md);
  }

  .hero-sub {
    font-size: 1.125rem;
    color: var(--color-text-muted);
    line-height: 1.7;
    margin-bottom: var(--space-lg);
    max-width: 480px;
  }

  .hero-actions {
    display: flex;
    gap: var(--space-sm);
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    padding: var(--space-sm) var(--space-lg);
    background: var(--color-primary);
    color: #fff;
    border-radius: var(--radius-sm);
    font-weight: 500;
    font-size: 0.9375rem;
    transition: background-color var(--transition);
  }

  .btn-primary:hover {
    background: var(--color-primary-container);
    text-decoration: none;
    color: #fff;
  }

  .btn-secondary {
    display: inline-flex;
    align-items: center;
    padding: var(--space-sm) var(--space-lg);
    background: transparent;
    color: var(--color-text-body);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    font-weight: 500;
    font-size: 0.9375rem;
    transition: color var(--transition), border-color var(--transition);
  }

  .btn-secondary:hover {
    color: var(--color-primary);
    border-color: var(--color-primary);
    text-decoration: none;
  }

  /* Visual card */
  .visual-card {
    background: var(--color-surface);
    border-radius: var(--radius-sm);
    padding: var(--space-lg);
  }

  .visual-label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
    margin-bottom: var(--space-md);
  }

  .visual-bars {
    display: flex;
    align-items: flex-end;
    gap: var(--space-xs);
    height: 100px;
  }

  .bar {
    flex: 1;
    background: var(--color-primary);
    border-radius: var(--radius-sm) var(--radius-sm) 0 0;
    opacity: 0.15;
    transition: opacity var(--transition);
  }

  .bar:hover {
    opacity: 1;
  }

  /* Topics */
  .topics-section {
    padding: var(--space-2xl) 0;
    background: var(--color-surface);
  }

  .section-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: var(--space-xl);
  }

  .section-head h2 {
    margin: 0;
  }

  .view-all {
    font-size: 0.875rem;
    color: var(--color-primary);
    font-weight: 500;
  }

  .topics-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-lg);
  }

  .topic-card {
    display: flex;
    flex-direction: column;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: var(--space-lg);
    text-decoration: none;
    transition: border-color var(--transition), transform var(--transition);
    min-height: 200px;
  }

  .topic-card:hover {
    border-color: var(--color-primary);
    transform: translateY(-1px);
    text-decoration: none;
  }

  .topic-card-meta {
    display: flex;
    gap: var(--space-xs);
    margin-bottom: var(--space-md);
  }

  .pill {
    display: inline-flex;
    align-items: center;
    padding: 3px 8px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-border);
    font-family: var(--font-mono);
    font-size: 0.625rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
  }

  .pill.category {
    color: var(--color-primary);
    border-color: var(--color-primary);
    background: var(--color-primary-light);
  }

  .topic-card h3 {
    font-size: 1rem;
    font-weight: 600;
    margin: 0 0 var(--space-sm) 0;
    color: var(--color-text);
  }

  .topic-card p {
    font-size: 0.875rem;
    color: var(--color-text-body);
    line-height: 1.5;
    margin: 0 0 var(--space-md) 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    flex: 1;
  }

  .topic-card-foot {
    display: flex;
    gap: var(--space-xs);
    padding-top: var(--space-md);
    border-top: 1px solid var(--color-border);
  }

  /* Features */
  .features-section {
    padding: var(--space-2xl) 0;
  }

  .features-section h2 {
    text-align: center;
    margin-bottom: var(--space-2xl);
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-lg);
  }

  .feature-card {
    background: var(--color-surface);
    border-radius: var(--radius-sm);
    padding: var(--space-xl);
    text-align: center;
  }

  .f-icon {
    display: block;
    font-size: 1.5rem;
    margin-bottom: var(--space-md);
    opacity: 0.5;
  }

  .feature-card h3 {
    font-size: 1.125rem;
    margin-bottom: var(--space-sm);
  }

  .feature-card p {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  /* CTA */
  .cta-section {
    padding: var(--space-2xl) 0;
    text-align: center;
  }

  .cta-section h2 {
    margin-bottom: var(--space-lg);
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .hero-inner {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .hero-text h1 {
      font-size: 2.25rem;
    }

    .hero-sub {
      max-width: 100%;
    }

    .hero-actions {
      justify-content: center;
    }

    .hero-visual {
      display: none;
    }

    .topics-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .features-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .topics-grid {
      grid-template-columns: 1fr;
    }

    .section-head {
      flex-direction: column;
      gap: var(--space-sm);
      align-items: flex-start;
    }

    .topic-card {
      padding: var(--space-md);
      min-height: auto;
    }
  }
</style>
