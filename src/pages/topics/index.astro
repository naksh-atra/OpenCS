---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import { categories } from '../../data/categories';

const allTopics = await getCollection('topics');
const url = Astro.url;
const categoryFilter = url.searchParams.get('category');
const engineFilter = url.searchParams.get('engine');
const difficultyFilter = url.searchParams.get('difficulty');
const statusFilter = url.searchParams.get('status');

const filteredTopics = allTopics.filter(t => {
  if (categoryFilter && t.data.category !== categoryFilter) return false;
  if (engineFilter && t.data.engine !== engineFilter) return false;
  if (difficultyFilter && t.data.difficulty !== difficultyFilter) return false;
  if (statusFilter && t.data.status !== statusFilter) return false;
  return true;
});

const sortedTopics = filteredTopics.sort((a, b) => a.data.order - b.data.order);
const publishedCount = allTopics.filter(t => t.data.status === 'published').length;
const totalCount = allTopics.length;
const engineOptions = [...new Set(allTopics.map(t => t.data.engine))];
const difficultyOptions = ['beginner', 'intermediate', 'advanced'];
const statusOptions = ['published', 'in-progress', 'planned'];

function buildUrl(params: Record<string, string | null>) {
  const merged = new URLSearchParams(url.searchParams);
  for (const [k, v] of Object.entries(params)) {
    if (v === null) merged.delete(k);
    else merged.set(k, v);
  }
  const s = merged.toString();
  return `/OpenCS/topics${s ? '?' + s : ''}`;
}

function isFilterActive(filter: string, value: string | null) {
  if (filter === 'category') return categoryFilter === value;
  if (filter === 'engine') return engineFilter === value;
  if (filter === 'difficulty') return difficultyFilter === value;
  if (filter === 'status') return statusFilter === value;
  return false;
}
---

<BaseLayout title="Topics" description="Browse all computer science topics with interactive visualizers">
  <Header />
  <main class="topics-page">
    <div class="topics-layout container">
      <!-- Sidebar Filters -->
      <aside class="topics-sidebar">
        <h3>Filters</h3>

        <div class="filter-group">
          <span class="filter-label">Category</span>
          <div class="filter-pills">
            <a href={buildUrl({ category: null, engine: null, difficulty: null, status: null })}
               class:list={['filter-pill', { active: !categoryFilter && !engineFilter && !difficultyFilter && !statusFilter }]}>
              All
            </a>
            {categories.map(cat => (
              <a href={buildUrl({ category: cat.slug })}
                 class:list={['filter-pill', { active: isFilterActive('category', cat.slug) }]}>
                {cat.label}
              </a>
            ))}
          </div>
        </div>

        <div class="filter-group">
          <span class="filter-label">Engine</span>
          <div class="filter-pills">
            {engineOptions.map(e => (
              <a href={buildUrl({ engine: e })}
                 class:list={['filter-pill', { active: isFilterActive('engine', e) }]}>
                {e}
              </a>
            ))}
          </div>
        </div>

        <div class="filter-group">
          <span class="filter-label">Difficulty</span>
          <div class="filter-pills">
            {difficultyOptions.map(d => (
              <a href={buildUrl({ difficulty: d })}
                 class:list={['filter-pill', { active: isFilterActive('difficulty', d) }]}>
                {d}
              </a>
            ))}
          </div>
        </div>

        <div class="filter-group">
          <span class="filter-label">Status</span>
          <div class="filter-pills">
            {statusOptions.map(s => (
              <a href={buildUrl({ status: s })}
                 class:list={['filter-pill', { active: isFilterActive('status', s) }]}>
                {s}
              </a>
            ))}
          </div>
        </div>
      </aside>

      <!-- Topic Cards Grid -->
      <section class="topics-content">
        <div class="topics-count">
          <p>{sortedTopics.length} of {totalCount} topics</p>
        </div>

        {/* Search */}
        <div class="topics-search">
          <input
            type="text"
            id="topicSearch"
            placeholder="Search topics by name..."
            class="search-input"
            autocomplete="off"
          />
          <span class="search-clear" id="searchClear" hidden>&#x2715;</span>
        </div>

        {sortedTopics.length === 0 ? (
          <div class="empty-state">
            <p>No topics match your filters.</p>
            <a href="/OpenCS/topics" class="btn-secondary">Clear filters</a>
          </div>
        ) : (
          <div class="topics-grid">
            {sortedTopics.map(topic => (
              <a href={`/OpenCS/topics/${topic.id.replace(/\.mdx?$/, '')}`} class="topic-card" data-topic-slug={topic.id.replace(/\.mdx?$/, '')}>
                <div class="topic-card-header">
                  <button class="topic-progress-btn" data-topic-slug={topic.id.replace(/\.mdx?$/, '')} onclick="event.preventDefault();" title="Mark as done" aria-label="Mark as completed">○</button>
                  <div class="topic-card-header-pills">
                    <span class="pill category">{topic.data.category}</span>
                    <span class="pill">{topic.data.engine}</span>
                  </div>
                </div>
                <h3>{topic.data.title}</h3>
                <p>{topic.data.description}</p>
                <div class="topic-card-footer">
                  <span class="pill difficulty">{topic.data.difficulty}</span>
                  <span class="pill time">{topic.data.estimatedTime}</span>
                </div>
                {topic.data.tags && topic.data.tags.length > 0 && (
                  <div class="topic-tags">
                    {topic.data.tags.slice(0, 3).map(tag => (
                      <span class="pill tag">{tag}</span>
                    ))}
                  </div>
                )}
              </a>
            ))}
          </div>
        )}
      </section>
    </div>
  </main>
  <Footer />
</BaseLayout>

<script>
  (function() {
    var input = document.getElementById('topicSearch');
    var clear = document.getElementById('searchClear');
    var cards = document.querySelectorAll('.topic-card');
    if (!input) return;

    function filterTopics() {
      var q = input.value.toLowerCase().trim();
      clear.hidden = q.length === 0;
      var visible = 0;
      cards.forEach(function(card) {
        var title = (card.querySelector('h3') || {}).textContent || '';
        var desc = (card.querySelector('p') || {}).textContent || '';
        var tags = card.querySelectorAll('.pill');
        var tagText = '';
        tags.forEach(function(t) { tagText += ' ' + t.textContent; });
        var match = !q || title.toLowerCase().indexOf(q) >= 0 || desc.toLowerCase().indexOf(q) >= 0 || tagText.toLowerCase().indexOf(q) >= 0;
        card.style.display = match ? '' : 'none';
        if (match) visible++;
      });
      var countEl = document.querySelector('.topics-count p');
      if (countEl) {
        countEl.textContent = visible + ' of ' + cards.length + ' topics' + (q ? ' (filtered)' : '');
      }
    }

    input.addEventListener('input', filterTopics);
    clear.addEventListener('click', function() {
      input.value = '';
      filterTopics();
      input.focus();
    });
  })();
</script>

<script>
  // Topic progress tracking
  (function() {
    function getVisited() {
      try { return JSON.parse(localStorage.getItem('opencs_visited') || '[]'); } catch(e) { return []; }
    }
    function setVisited(arr) {
      try { localStorage.setItem('opencs_visited', JSON.stringify(arr)); } catch(e) {}
    }

    function updateProgressBtns() {
      var visited = getVisited();
      document.querySelectorAll('.topic-progress-btn').forEach(function(btn) {
        var slug = btn.getAttribute('data-topic-slug');
        if (visited.indexOf(slug) >= 0) {
          btn.textContent = '✓';
          btn.classList.add('completed');
          btn.setAttribute('aria-label', 'Completed');
        } else {
          btn.textContent = '○';
          btn.classList.remove('completed');
          btn.setAttribute('aria-label', 'Mark as completed');
        }
      });
      // Update progress count
      var total = document.querySelectorAll('.topic-card').length;
      var done = visited.length;
      var countEl = document.querySelector('.topics-count p');
      if (countEl && total > 0) {
        var baseText = countEl.textContent.replace(/ \(.*\)/, '').replace(/^\d+/, done + '/' + total);
        countEl.textContent = baseText;
      }
    }

    document.addEventListener('click', function(e) {
      var btn = e.target.closest('.topic-progress-btn');
      if (!btn) return;
      e.preventDefault();
      e.stopPropagation();
      var slug = btn.getAttribute('data-topic-slug');
      var visited = getVisited();
      var idx = visited.indexOf(slug);
      if (idx >= 0) {
        visited.splice(idx, 1);
      } else {
        visited.push(slug);
      }
      setVisited(visited);
      updateProgressBtns();
    });

    updateProgressBtns();
  })();
</script>

<style>
  .topics-page {
    padding: calc(var(--header-height) + var(--space-xl)) 0 var(--space-2xl);
  }

  .topics-layout {
    display: grid;
    grid-template-columns: var(--sidebar-width) 1fr;
    gap: var(--space-2xl);
    align-items: start;
  }

  /* Sidebar */
  .topics-sidebar {
    position: sticky;
    top: calc(var(--header-height) + var(--space-lg));
    padding: var(--space-lg);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
  }

  .topics-sidebar h3 {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
    margin-bottom: var(--space-lg);
    font-weight: 500;
  }

  .filter-group {
    margin-bottom: var(--space-lg);
  }

  .filter-group:last-child {
    margin-bottom: 0;
  }

  .filter-label {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
    margin-bottom: var(--space-sm);
    font-weight: 500;
  }

  .filter-pills {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
  }

  /* Content area */
  .topics-content {
    min-width: 0;
  }

  .topics-count {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    margin-bottom: var(--space-lg);
  }

  .topics-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-lg);
  }

  .topic-card {
    display: flex;
    flex-direction: column;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: var(--space-lg);
    text-decoration: none;
    transition: border-color var(--transition), transform var(--transition);
    min-height: 200px;
  }

  .topic-card:hover {
    border-color: var(--color-primary);
    transform: translateY(-1px);
    text-decoration: none;
  }

  .topic-card-header {
    display: flex;
    align-items: flex-start;
    gap: var(--space-sm);
    margin-bottom: var(--space-md);
  }

  .topic-card-header-pills {
    display: flex;
    gap: var(--space-xs);
    flex-wrap: wrap;
    flex: 1;
  }

  .topic-progress-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    min-width: 28px;
    padding: 0;
    background: transparent;
    border: 1px solid var(--color-border);
    border-radius: 50%;
    font-size: 0.875rem;
    color: var(--color-text-muted);
    cursor: pointer;
    transition: all var(--transition);
    line-height: 1;
    margin-top: 2px;
  }

  .topic-progress-btn:hover {
    border-color: var(--color-success);
    color: var(--color-success);
    background: var(--color-success-bg);
  }

  .topic-progress-btn.completed {
    border-color: var(--color-success);
    color: var(--color-success);
    background: var(--color-success-bg);
  }

  .topic-progress-btn.completed:hover {
    border-color: var(--color-error);
    color: var(--color-error);
    background: var(--color-deleted-bg);
  }

  .topic-card h3 {
    font-family: var(--font-sans);
    font-size: 1.125rem;
    font-weight: 600;
    margin: 0 0 var(--space-sm) 0;
    color: var(--color-text);
    line-height: 1.3;
  }

  .topic-card p {
    font-size: 0.875rem;
    color: var(--color-text-body);
    line-height: 1.5;
    margin: 0 0 var(--space-md) 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    flex: 1;
  }

  .topic-card-footer {
    display: flex;
    gap: var(--space-sm);
    padding-top: var(--space-md);
    border-top: 1px solid var(--color-border);
  }

  .topic-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin-top: var(--space-sm);
  }

  .pill {
    display: inline-flex;
    align-items: center;
    padding: 3px 8px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-border);
    font-family: var(--font-mono);
    font-size: 0.625rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
    background: transparent;
  }

  .pill.category {
    color: var(--color-primary);
    border-color: var(--color-primary);
    background: var(--color-primary-light);
  }

  .empty-state {
    text-align: center;
    padding: var(--space-2xl);
    color: var(--color-text-muted);
  }

  .empty-state p {
    margin-bottom: var(--space-md);
  }

  /* Filter pill interactive states */
  .filter-pill {
    display: inline-flex;
    padding: var(--space-sm) var(--space-md);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    font-size: 0.8125rem;
    color: var(--color-text-body);
    cursor: pointer;
    transition: color var(--transition), border-color var(--transition), background-color var(--transition);
    text-decoration: none;
    user-select: none;
  }

  .filter-pill:hover {
    color: var(--color-primary);
    border-color: var(--color-primary);
    text-decoration: none;
  }

  .filter-pill.active {
    background: var(--color-primary-light);
    color: var(--color-primary);
    border-color: var(--color-primary);
  }

  /* Search input */
  .topics-search {
    position: relative;
    margin-bottom: var(--space-lg);
  }

  .search-input {
    width: 100%;
    padding: 10px 36px 10px 14px;
    font-size: 0.875rem;
    font-family: var(--font-body);
    color: var(--color-text);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    outline: none;
    transition: border-color var(--transition), box-shadow var(--transition);
  }

  .search-input::placeholder {
    color: var(--color-text-muted);
  }

  .search-input:focus {
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px var(--color-primary-light);
  }

  .search-clear {
    position: absolute;
    right: 12px;
    top: 50%;
    transform: translateY(-50%);
    font-size: 0.875rem;
    color: var(--color-text-muted);
    cursor: pointer;
    padding: 4px;
    line-height: 1;
  }

  .search-clear:hover {
    color: var(--color-text);
  }

  /* Responsive */
  @media (max-width: 768px) {
    .topics-layout {
      grid-template-columns: 1fr;
    }

    .topics-sidebar {
      position: static;
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-md);
      padding: var(--space-md);
    }

    .topics-sidebar h3 {
      width: 100%;
      margin-bottom: 0;
    }

    .filter-group {
      margin-bottom: 0;
    }

    .topics-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
